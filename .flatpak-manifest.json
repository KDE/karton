{
    "app-id": "org.kde.karton",
    "branch": "master",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "karton",
    "tags": [
        "nightly"
    ],
    "rename-icon": "karton_logo",
    "finish-args": [
        "--device=all",
        "--filesystem=home",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/*.a",
        "/lib/*.la",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gtk-doc",
        "/share/kdevappwizard",
        "/share/man",
        "/share/pkgconfig",
        "/share/qlogging-categories6",
        "/usr",
        "/var"
    ],
    "modules": [
        {
            "name": "libvirt-glib",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtests=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.libvirt.org/glib/libvirt-glib-5.0.0.tar.xz",
                    "sha256": "9bfec346382416a3575d87299bc641b2a464aa519fd9b1287e318aa43a2f3b8b",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 11560,
                        "stable-only": true,
                        "url-template": "https://download.libvirt.org/glib/libvirt-glib-$version.tar.xz"
                    }
                }
            ],
            "modules": [
                {
                    "name": "libnl",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/thom311/libnl/releases/download/libnl3_12_0/libnl-3.12.0.tar.gz",
                            "sha256": "fc51ca7196f1a3f5fdf6ffd3864b50f4f9c02333be28be4eeca057e103c0dd18",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 1684,
                                "stable-only": true,
                                "url-template": "https://github.com/thom311/libnl/releases/download/libnl${major}_${minor}_${patch}/libnl-$version.tar.gz"
                            }
                        }
                    ]
                },
                {
                    "name": "libtirpc",
                    "config-opts": [
                        "--disable-gssapi",
                        "--libdir=/app/lib"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://downloads.sourceforge.net/sourceforge/libtirpc/libtirpc-1.3.8.tar.bz2",
                            "sha256": "8839959bfcc7a0f4c609d8e4f53f1c67ae33de23775ec35beb39ff15adf11920",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 1740,
                                "stable-only": true,
                                "url-template": "https://downloads.sourceforge.net/sourceforge/libtirpc/libtirpc-$version.tar.bz2"
                            }
                        }
                    ]
                },
                {
                    "name": "rpcsvc-proto",
                    "buildsystem": "autotools",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/thkukuk/rpcsvc-proto/archive/v1.4.4.tar.gz",
                            "sha256": "7988641deae8463303b6273d7af98ece09111c385d4c9134a142a5fad3cdfef8",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 155452,
                                "stable-only": true,
                                "url-template": "https://github.com/thkukuk/rpcsvc-proto/archive/v$version.tar.gz"
                            }
                        }
                    ]
                },
                {
                    "name": "libvirt",
                    "builddir": true,
                    "buildsystem": "meson",
                    "build-options": {
                        "cflags": "-I/app/include/tirpc -ltirpc"
                    },
                    "config-opts": [
                        "-Ddocs=disabled",
                        "-Dtests=disabled"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://libvirt.org/sources/libvirt-12.7.0.tar.xz",
                            "sha256": "7ec1a04e7e4f4069353d4daac117bbe869287f5b202695de61fe1b079efb6cb6",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 13830,
                                "stable-only": true,
                                "url-template": "https://libvirt.org/sources/libvirt-$version.tar.xz"
                            }
                        },
                        {
                            "type": "patch",
                            "path": "flatpak/libvirt-use-monitor-in-xdg-runtime-dir.patch"
                        }
                    ]
                }
            ]
        },
        {
            "name": "spice-gtk",
            "buildsystem": "meson",
            "build-options": {
                "env": {
                    "PYTHONPATH": "/app"
                }
            },
            "config-opts": [
                "-Dgtk=disabled",
                "-Dgtk_doc=disabled",
                "-Dpolkit=disabled",
                "-Dusbredir=disabled",
                "-Dvapi=disabled",
                "-Dwebdav=enabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.freedesktop.org/spice/spice-gtk/-/archive/v0.43/spice-gtk-v0.43.tar.gz",
                    "sha256": "c1a59377d1cc0a62b38854b8c8f69d9ee8c75eab90df9bb96fe6b382d1057d63",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 11576,
                        "stable-only": true,
                        "url-template": "https://gitlab.freedesktop.org/spice/spice-gtk/-/archive/v$version/spice-gtk-v$version.tar.gz"
                    }
                }
            ],
            "modules": [
                {
                    "name": "spice-protocol",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/releases/spice-protocol-0.14.5.tar.xz",
                            "sha256": "baf58449f6e89d19f475899ad5fb9196fdc46c03cc53233f4e39cf2978f9cff7",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 14892,
                                "stable-only": true,
                                "url-template": "https://www.spice-space.org/download/releases/spice-protocol-$version.tar.xz"
                            }
                        }
                    ]
                },
                {
                    "name": "phodav",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dsystemdsystemunitdir=/app/lib/systemd/system",
                        "-Dudevrulesdir=usr/lib/udev/rules.d"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://download.gnome.org/sources/phodav/3.0/phodav-3.0.tar.xz",
                            "sha256": "392ec2d06d50300dcff1ef269a2a985304e29bce3520002fca29f2edc1d138d1",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 9670,
                                "stable-only": true,
                                "url-template": "https://download.gnome.org/sources/phodav/$version/phodav-$version.tar.xz"
                            }
                        }
                    ]
                },
                {
                    "name": "python-pyparsing",
                    "buildsystem": "simple",
                    "build-commands": [
                        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pyparsing\" --no-build-isolation"
                    ],
                    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/f3/91/9c6ee907786a473bf81c5f53cf703ba0957b23ab84c264080fb5a450416f/pyparsing-3.3.2.tar.gz",
                            "sha256": "c777f4d763f140633dcb6d8a3eda953bf7a214dc4eff598413c070bcdc117cbc",
                            "x-checker-data": {
                                "type": "pypi",
                                "name": "pyparsing"
                            }
                        }
                    ]
                },
                {
                    "name": "libcacard",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/libcacard/libcacard-2.8.2.tar.xz",
                            "sha256": "45fc28a6ff3c7a359d4448132ca190f0a9c760540c445dba4597a5b71de40f68",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 18776,
                                "stable-only": true,
                                "url-template": "https://www.spice-space.org/download/libcacard/libcacard-$version.tar.xz"
                            }
                        }
                    ]
                },
                {
                    "name": "spice",
                    "buildsystem": "autotools",
                    "config-opts": [
                        "--disable-lz4",
                        "--disable-manual",
                        "--disable-test"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/releases/spice-0.16.0.tar.bz2",
                            "sha256": "0a6ec9528f05371261bbb2d46ff35e7b5c45ff89bb975a99af95a5f20ff4717d",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 4871,
                                "stable-only": true,
                                "url-template": "https://www.spice-space.org/download/releases/spice-$version.tar.bz2"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "dtc",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://git.kernel.org/pub/scm/utils/dtc/dtc.git/snapshot/v1.8.1.tar.gz",
                    "sha256": "a6bea318d8d4c80ad9637a0c94571ba1148d482604006f02b70e70126ac2310b",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 16911,
                        "stable-only": true,
                        "url-template": "https://git.kernel.org/pub/scm/utils/dtc/dtc.git/snapshot/v$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "qemu",
            "config-opts": [
                "--disable-docs",
                "--disable-user",
                "--enable-kvm",
                "--enable-spice",
                "--enable-opengl",
                "--enable-virglrenderer",
                "--enable-usb-redir",
                "--enable-smartcard",
                "--enable-slirp",
                "--python=/bin/python3",
                "--target-list=x86_64-softmmu,i386-softmmu"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qemu.org/qemu-11.1.1.tar.xz",
                    "sha256": "079ffbff8a7111bbc89022107cbabf3bbfd614d5fc9d7cc675991196aca12482",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13607,
                        "stable-only": true,
                        "url-template": "https://download.qemu.org/qemu-$version.tar.xz"
                    }
                }
            ],
            "modules": [
                {
                    "name": "slirp",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v4.9.4/libslirp-v4.9.4.tar.gz",
                            "sha256": "3998863b020aeda34bddc567097c6efba55a78cdf6eeee6bcd42c11ef23967da",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 96796,
                                "stable-only": true,
                                "url-template": "https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v$version/libslirp-v$version.tar.gz"
                            }
                        }
                    ]
                },
                {
                    "name": "libusb",
                    "config-opts": [
                        "--disable-udev"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2",
                            "sha256": "fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 1749,
                                "stable-only": true,
                                "url-template": "https://github.com/libusb/libusb/releases/download/v$version/libusb-$version.tar.bz2"
                            }
                        }
                    ]
                },
                {
                    "name": "usbredir",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dtools=disabled"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://spice-space.org/download/usbredir/usbredir-0.15.0.tar.xz",
                            "sha256": "6dc2a380277688a068191245dac2ab7063a552999d8ac3ad8e841c10ff050961",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 16012,
                                "stable-only": true,
                                "url-template": "https://spice-space.org/download/usbredir/usbredir-$version.tar.xz"
                            }
                        }
                    ]
                },
                {
                    "name": "python-pyyaml",
                    "buildsystem": "simple",
                    "build-commands": [
                        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pyyaml\" --no-build-isolation"
                    ],
                    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz",
                            "sha256": "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f",
                            "x-checker-data": {
                                "type": "pypi",
                                "name": "pyyaml"
                            }
                        }
                    ]
                },
                {
                    "name": "virglrenderer",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.3.0/virglrenderer-1.3.0.tar.bz2",
                            "sha256": "088040d130eaa0458a978fe7867fbfb1fcf1fdff52bf3b27a00658828bc4189f",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 15968,
                                "stable-only": true,
                                "url-template": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/$version/virglrenderer-$version.tar.bz2"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "libosinfo",
            "buildsystem": "meson",
            "config-opts": [
                "-Dwith-pci-ids-path=/app/share/hwdata/pci.ids",
                "-Dwith-usb-ids-path=/app/share/hwdata/usb.ids",
                "-Denable-gtk-doc=false",
                "-Denable-tests=false"
            ],
            "post-install": [
                "install -Dm644 ../pci.ids /app/share/hwdata/pci.ids",
                "install -Dm644 ../usb.ids /app/share/hwdata/usb.ids"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/libosinfo/libosinfo.git",
                    "branch": "main",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dsystemdsystemunitdir=/app/lib/systemd/system",
                        "-Dudevrulesdir=usr/lib/udev/rules.d"
                    ]
                },
                {
                    "type": "file",
                    "path": "flatpak/pci.ids"
                },
                {
                    "type": "file",
                    "path": "flatpak/usb.ids"
                }
            ],
            "modules": [
                {
                    "name": "cdrkit",
                    "buildsystem": "cmake",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://github.com/Distrotech/cdrkit",
                            "branch": "7b4bb72389ea5ea3ecc94545036dcff4728ec38a"
                        },
                        {
                            "type": "patch",
                            "path": "flatpak/genisoimage-extern.patch"
                        },
                        {
                            "type": "patch",
                            "path": "flatpak/cdrkit-build-fix.patch"
                        },
                        {
                            "type": "patch",
                            "path": "flatpak/cdrkit-add-cmake_minimum_required.patch"
                        }
                    ]
                },
                {
                    "name": "osinfo-db-tools",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                            "tag": "v1.12.0",
                            "commit": "e5564be303bfac49cc3490bd0fada342cd65566f",
                            "x-checker-data": {
                                "type": "git",
                                "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                                "tag-pattern": "^(v[\\d.]+)$"
                            }
                        }
                    ]
                },
                {
                    "name": "osinfo-db",
                    "buildsystem": "simple",
                    "builddir": true,
                    "build-commands": [
                        "make -j $FLATPAK_BUILDER_N_JOBS",
                        "osinfo-db-import --dir /app/share/osinfo/ osinfo-db-*.tar.xz"
                    ],
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db.git",
                            "branch": "main"
                        }
                    ]
                }
            ]
        },
        {
            "name": "org.kde.karton",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
