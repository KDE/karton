                {
                    "name": "virglrenderer",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.3.0/virglrenderer-1.3.0.tar.bz2",
                            "sha256": "088040d130eaa0458a978fe7867fbfb1fcf1fdff52bf3b27a00658828bc4189f",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 15968,
                                "stable-only": true,
                                "url-template": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/$version/virglrenderer-$version.tar.bz2"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "libosinfo",
            "buildsystem": "meson",
            "config-opts": [
                "-Dwith-pci-ids-path=/app/share/hwdata/pci.ids",
                "-Dwith-usb-ids-path=/app/share/hwdata/usb.ids"
            ],
            "post-install": [
                "install -Dm644 ../pci.ids /app/share/hwdata/pci.ids",
                "install -Dm644 ../usb.ids /app/share/hwdata/usb.ids"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/libosinfo/libosinfo.git",
                    "branch": "main",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dsystemdsystemunitdir=/app/lib/systemd/system",
                        "-Dudevrulesdir=usr/lib/udev/rules.d"
                    ]
                },
                {
                    "type": "file",
                    "path": "flatpak/pci.ids"
                },
                {
                    "type": "file",
                    "path": "flatpak/usb.ids"
                }
            ],
            "modules": [
                {
                    "name": "cdrkit",
                    "buildsystem": "cmake",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://github.com/Distrotech/cdrkit",
                            "branch": "7b4bb72389ea5ea3ecc94545036dcff4728ec38a"
                        },
                        {
                            "type": "patch",
                            "path": "flatpak/genisoimage-extern.patch"
                        },
                        {
                            "type": "patch",
                            "path": "flatpak/cdrkit-build-fix.patch"
                        }
                    ]
                },
                {
                    "name": "osinfo-db-tools",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                            "tag": "v1.12.0",
                            "commit": "e5564be303bfac49cc3490bd0fada342cd65566f",
                            "x-checker-data": {
                                "type": "git",
                                "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                                "tag-pattern": "^(v[\\d.]+)$"
                            }
                        }
                    ]
                },
                {
                    "name": "osinfo-db",
                    "buildsystem": "simple",
                    "builddir": true,
                    "build-commands": [
                        "make",
                        "osinfo-db-import --dir /app/share/osinfo/ osinfo-db-*.tar.xz"
                    ],
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db.git",
                            "branch": "main"
                        }
                    ]
                }
            ]
        },
        {
            "name": "org.kde.karton",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
